{
  "name": "brewlite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "npm --prefix backend ci && npm --prefix frontend ci",
    "dev": "concurrently -k -n api,web \"npm --prefix backend run start:dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:db": "node scripts/test-checkout-db.cjs",
    "qa:up": "node scripts/qa-stack.cjs up",
    "qa:down": "node scripts/qa-stack.cjs down",
    "qa:status": "node scripts/qa-stack.cjs status",
    "qa:benchmark": "node scripts/benchmark-api.cjs",
    "docs:check": "node scripts/check-contract.mjs",
    "docs:schema": "npm --prefix backend run prisma:validate -- --schema ../docs/diagrams/schema.prisma",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:migrate": "npm --prefix backend run prisma:migrate --",
    "db:studio": "npm --prefix backend run prisma:studio"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.1",
    "js-yaml": "^4.3.2"
  }
}
