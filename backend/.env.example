PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://brewlite:brewlite_dev@localhost:5432/brewlite?schema=public
# JWT secret for signing and verifying customer tokens (HS256).
# Must be at least 32 characters long.
# Generate locally using:
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object { [char]$_ })
#   Linux/macOS/Git Bash: openssl rand -hex 32
# Never commit real secrets to Git.
JWT_SECRET=

# VNPay Sandbox Configuration (use your own merchant credentials; never commit real keys)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET_REPLACE_WITH_YOUR_OWN
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
